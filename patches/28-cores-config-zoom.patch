+.pcard{overflow:hidden;isolation:isolate;background:#23382f}
+.pcard::before,.pcard::after{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit}
+.pcard::before{background:var(--img) center/cover;animation:pcz 14s ease-in-out infinite alternate;will-change:transform}
+.pcard::after{background:linear-gradient(180deg,rgba(10,18,17,.05) 25%,rgba(10,18,17,.8) 100%)}
+.pcard:nth-child(even)::before{animation-name:pczo;animation-delay:-5s}.pcard:nth-child(3n)::before{animation-delay:-9s}
+@media (prefers-reduced-motion:reduce){.pcard::before{animation-duration:50s}}
