 .btnrow .b2{min-height:50px;border-radius:14px;background:var(--ink);color:#FCF8EE;font-weight:800}
 /* barra inferior */
-.nav{position:absolute;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1fr;background:var(--card);border-top:1px solid var(--line);padding:6px 0 calc(6px + env(safe-area-inset-bottom,0px));z-index:20}
