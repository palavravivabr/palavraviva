diff --git a/styles.css b/styles.css
index 405d1cf..58cd318 100644
--- a/styles.css
+++ b/styles.css
@@ -298 +298,14 @@
 .dica button{flex:none;min-height:40px;padding:0 14px;border-radius:14px;background:var(--ink);color:#FCF8EE;font-weight:700;font-size:13px}
+.planohero{background:var(--card);border-radius:20px;padding:16px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:10px}
+.planohero h2{font:700 1.3rem var(--serif);color:var(--accent)}
+.planohero p{font-size:.95rem;line-height:1.5;color:var(--soft)}
+.pbar{height:10px;border-radius:6px;background:var(--card-2);overflow:hidden}
+.pbar i{display:block;height:100%;background:var(--gold);border-radius:6px}
+.planosec{font:800 10.5px var(--ui);letter-spacing:.14em;text-transform:uppercase;color:var(--tagink);margin:6px 0 0}
+.prow{display:flex;align-items:center;gap:8px;background:var(--card);border-radius:16px;box-shadow:var(--shadow);padding:8px 10px}
+.pler{flex:1;min-width:0;min-height:48px;text-align:left;display:flex;flex-direction:column;justify-content:center;padding:0 6px}
+.pler strong{font:700 1.05rem var(--serif)}
+.pler span{font-size:12px;color:var(--soft)}
+.pest{flex:none;min-height:40px;padding:0 12px;border-radius:14px;background:var(--gold-soft);color:var(--tagink);font-weight:700;font-size:13px}
+.pok{flex:none;width:44px;height:44px;border-radius:50%;border:2px solid var(--line);color:var(--soft);font-size:18px;font-weight:800}
+.pok[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#FCF8EE}
